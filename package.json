{
  "name": "mail-assistant-addin",
  "version": "0.0.1",
  "license": "MIT",
  "config": {
    "app_to_debug": "outlook",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "watch": "webpack --mode development --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mock": "cross-env VITE_MOCK=1 webpack serve --mode development"
  },
  "dependencies": {
    "@azure/msal-browser": "5.26.0",
    "@fluentui/react-components": "9.74.11",
    "@fluentui/react-icons": "2.0.344",
    "core-js": "3.51.0",
    "es6-promise": "4.2.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "regenerator-runtime": "0.14.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@types/office-js": "1.0.613",
    "@types/office-runtime": "1.0.40",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/webpack": "5.28.5",
    "@types/webpack-env": "1.18.8",
    "acorn": "8.19.0",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "cross-env": "10.1.0",
    "eslint-plugin-office-addins": "4.0.10",
    "eslint-plugin-react": "7.37.5",
    "file-loader": "6.2.0",
    "html-loader": "5.1.0",
    "html-webpack-plugin": "5.6.8",
    "less": "4.9.1",
    "less-loader": "12.3.3",
    "office-addin-cli": "2.0.10",
    "office-addin-debugging": "7.0.1",
    "office-addin-dev-certs": "3.0.1",
    "office-addin-lint": "3.0.10",
    "office-addin-manifest": "3.0.1",
    "office-addin-prettier-config": "2.0.5",
    "os-browserify": "0.3.0",
    "process": "0.11.10",
    "source-map-loader": "5.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "webpack": "5.112.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "6.1.0"
  },
  "prettier": "office-addin-prettier-config"
}
