# Copy to .env (git-ignored). Read by webpack at build time and inlined into the bundle: never put secrets here.

VITE_ENTRA_CLIENT_ID=
VITE_API_BASE_URL=https://localhost:8080
VITE_MAX_EMAILS=300
VITE_MAX_BODY_CHARS=6000
# 1 = fixture emails, no Outlook/Graph/sign-in needed (backend needs DEV_AUTH_BYPASS=1)
VITE_MOCK=
# Production add-in URL with trailing slash; replaces https://localhost:3000/ in the built manifest.
ADDIN_PROD_URL=
